{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/exec", { "prepareCmd": "make notarize-release RELEASE_VERSION=${nextRelease.version}" }],
    [
      "@jno21/semantic-release-github-commit",
      {
        "files": ["VERSION"],
        "commitMessage": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "draftRelease": true,
        "assets": [
          { "path": "dist/*.zip", "label": "Endelito macOS bundle and CLI" }
        ]
      }
    ]
  ]
}
